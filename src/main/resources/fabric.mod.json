{
	"schemaVersion": 1,
	"id": "buildupmobtweaks",
	"version": "${version}",
	"name": "Buildup Mob Tweaks",
	"description": "Vanilla+ mob behavior and AI improvements for Buildup. Configurable diagnostic traits and data-driven birth equipment pools; advanced AI is not implemented.",
	"authors": [
		"Buildup contributors"
	],
	"license": "MIT",
	"icon": "assets/buildupmobtweaks/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"com.davidblackcn.buildupmobtweaks.BuildupMobTweaks"
		],
		"client": [
			"com.davidblackcn.buildupmobtweaks.client.BuildupMobTweaksClient"
		],
		"fabric-datagen": [
			"com.davidblackcn.buildupmobtweaks.client.BuildupMobTweaksDataGenerator"
		]
	},
	"mixins": [
		"buildup-mob-tweaks.mixins.json",
		{
			"config": "buildup-mob-tweaks.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.19.5",
		"minecraft": "~26.3",
		"java": ">=25",
		"fabric-api": "*",
		"fzzy_config": "=0.7.7+fix3+26.3",
		"fabric-language-kotlin": ">=1.14.1+kotlin.2.4.20"
	}
}
